{
  "manifest_version": 3,
  "name": "Fanfold",
  "version": "0.1.0",
  "description": "Lets the Fanfold app on this computer work in the tabs of the Fanfold tab group, and nowhere else.",
  "minimum_chrome_version": "120",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Fanfold",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
